# Pick whichever LLM backend you want for Phase 3+.
# Only one is required for the LLM reranker.

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: lets you bump the Semantic Scholar rate limit (~1 req/s unauth
# -> ~100 req/s with a key). Not required for the demo.
SEMANTIC_SCHOLAR_API_KEY=

# Required if RETRIEVAL_SOURCE=serpapi. Sign up at https://serpapi.com/.
# Each search = 1 credit; results cached on disk so re-runs are free.
SERPAPI_KEY=

# Retrieval source: serpapi (Google Scholar via SerpAPI) | semantic_scholar.
# Default: serpapi.
RETRIEVAL_SOURCE=serpapi

# Which LLM to use in Phase 3 (claude | deepseek | openai | gemini).
# Default: claude.
RERANKER_BACKEND=claude

# Optional model override. Examples:
#   claude    -> claude-haiku-4-5 (default), claude-sonnet-4-6
#   deepseek  -> deepseek-chat (default), deepseek-reasoner
RERANKER_MODEL=
